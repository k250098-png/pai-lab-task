def majority_element(nums):
    freq = {}
    n = len(nums)

    for num in nums:
        freq[num] = freq.get(num, 0) + 1
        if freq[num] > n // 2:
            return num

    return None


if __name__ == "__main__":
    print(majority_element([2, 2, 1, 1, 1, 2, 2]))  
    print(majority_element([3, 3, 4, 2, 3, 3, 3]))  
